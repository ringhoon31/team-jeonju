         <!--배너박스--> 
         <div class="banner_box" data-layout-area="BANNER_BOX_01" id="ad_wrap_group6" data-layout-area-cnt="1"> 
          <script type="text/javascript">
	$("#ad_wrap_group6").hide();
	//<![CDATA[
	$.ajax({
		type : "GET",
		url : "/wps/engine/rest/bannerGroup",
		dataType:"json",
		data:{
			"groupSeq" : '6',
			"mediaSeq" : '1'
		},
		success: function (o) {
			if(o.groupDetail != null && o.groupDetail != ''){
				const groupDetail = o.groupDetail;
				const useYn = groupDetail.useYn;
				
				if (useYn !== "Y") {
					return;
				}

				const bannerList = o.bannerList;
				const rollingType = (groupDetail.rollingType == '0'? false : true); //false:고정, true:롤링
				let html = "";

				if(rollingType){
					html += `<div id='group6Cycle' data-cycle-slides='> div'>`;
				}
				
				$.each(bannerList, function (i, item) {
					const imgUrl = item.advertisingImgUrl;
					const target = item.advertisingLinkTarget == 'S' ? '' : '_blank';
					const deviceCheck= item.deviceCheck == 'W' ? '' : 'm_banner';

					if(!rollingType){
						if(item.advertisingLinkUrl != 'null' &&  item.advertisingLinkUrl != ''){
							html += "<a href='"+item.advertisingLinkUrl+"' class='banner_area " + deviceCheck+ "' target='" + target + "'>";
						}
						if(item.appointHeight == '' || item.appointHeight == 'null'){
							html += "<img src='"+imgUrl +"' width='"+item.advertisingWidth+"' height='"+item.advertisingHeight+"' alt='배너'>";
						}else{
							html += "<img src='"+imgUrl +"' width='"+item.appointWidth+"' height='"+item.appointHeight+"' alt='배너'>";
						}
						if(item.advertisingLinkUrl != 'null' &&  item.advertisingLinkUrl != ''){
							html += "</a>";
						}
					}else{
						html += "<div id='"+item.advertisingSeq+"' class='swiper-slide'><div>";
						html += "<a href='"+item.advertisingLinkUrl+"' class='banner_area " + deviceCheck+ "' target='" + target + "'>";
						if(item.appointHeight == '' || item.appointHeight == 'null'){
							html += "<img src='"+imgUrl +"' width='"+item.advertisingWidth+"' height='"+item.advertisingHeight+"' alt='배너'>";
						}else{
							html += "<img src='"+imgUrl +"' width='"+item.appointWidth+"' height='"+item.appointHeight+"' alt='배너'>";
						}
						html += "</a></div></div>";
					}
				});
				
				if(rollingType){
					html += "</div>";
				}
				
				$("#ad_wrap_group6").append(html);
				
				if(rollingType){
					$(`#group6Cycle`).cycle({
						fx : (groupDetail.rollingType == '1'? 'scrollVert' : 'scrollHorz'),
						timeout : (groupDetail.rollingTime * 1000)
					});
				}

				$("#ad_wrap_group6").show();
			}
		}
	});
	//]]>
</script>
