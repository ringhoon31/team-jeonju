     <script>
  // 검색 버튼을 클릭했을 때 search_bar를 표시하는 함수
  function searchBtn() {
    var searchBar = document.getElementById('search_bar');
    searchBar.style.display = 'block'; // search_bar를 표시
  }

  // 문서 전체에 클릭 이벤트를 설정
  document.addEventListener('click', function(event) {
    var searchBar = document.getElementById('search_bar');
    var searchBtnElement = document.querySelector('.searchBtn');
    
    // 클릭한 요소가 search_bar 또는 검색 버튼이 아닌 경우에만 search_bar를 숨김
    if (!searchBar.contains(event.target) && !searchBtnElement.contains(event.target)) {
      searchBar.style.display = 'none';
    }
  });

  // search_inner 내부를 클릭할 때 이벤트 전파 중지
  document.querySelector('.search_inner').addEventListener('click', function(event) {
    event.stopPropagation(); // 이벤트 전파 중지
  });
</script>
